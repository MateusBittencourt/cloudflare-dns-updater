# Create a token with Zone > DNS > Edit, restricted to this zone.
CF_API_TOKEN=replace-with-your-api-token
CF_ZONE_ID=replace-with-your-zone-id

# Existing AAAA records to update, separated by commas.
CF_RECORDS=example.com,home.example.com

# How often to compare the local IPv6 address with the in-memory cache.
CHECK_INTERVAL=5m

# Recheck Cloudflare and the router even if the local address is unchanged.
FULL_CHECK_INTERVAL=24h

# Usually leave unset: the kernel's default IPv6 route chooses the address.
# Set this only if the server has multiple interfaces/default routes.
# IPV6_INTERFACE=eth0

# Optional Huawei EG8145V5-V2 IPv6 port-mapping integration. If any of these
# variables is set, all four are required. Names must match existing mappings.
# ROUTER_URL=http://192.168.18.1
# ROUTER_USERNAME=replace-with-router-username
# ROUTER_PASSWORD=replace-with-router-password
# ROUTER_IPV6_MAPPINGS=nginx
